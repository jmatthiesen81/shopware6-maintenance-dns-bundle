{
    "name": "devable/shopware6-maintenance-dns-bundle",
    "description": "Symfony bundle that resolves DNS/DynDNS hostnames and adds their IP addresses to the Shopware 6 maintenance mode allowlist, persistently via console command or temporarily at runtime",
    "type": "symfony-bundle",
    "license": "MPL-2.0",
    "authors": [
        {
            "name": "Jan Matthiesen",
            "homepage": "https://devable.me",
            "role": "Manufacturer"
        }
    ],
    "keywords": [
        "shopware",
        "shopware6",
        "maintenance",
        "maintenance-mode",
        "whitelist",
        "allowlist",
        "ip-whitelist",
        "dns",
        "dyndns",
        "dynamic-dns",
        "sales-channel",
        "symfony",
        "symfony-bundle"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "psr/cache": "^2.0 || ^3.0",
        "psr/clock": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "shopware/core": "~6.7.0",
        "symfony/clock": "^7.0",
        "symfony/console": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/lock": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.8",
        "shopware/storefront": "~6.7.0",
        "symfony/cache": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Devable\\MaintenanceDnsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devable\\MaintenanceDnsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false,
            "symfony/runtime": false
        }
    },
    "suggest": {
        "shopware/storefront": "Runtime mode for storefront requests (the Store API is supported by shopware/core alone)"
    }
}
